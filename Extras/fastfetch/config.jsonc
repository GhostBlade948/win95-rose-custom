// win95-rose-custom: fastfetch with the Windows 95 flag in the theme's colours.
//
// Installed to ~/.config/fastfetch/config.jsonc by shell-setup.sh, which keeps
// any config you already had as config.jsonc.bak.
//
// "Windows 95" is one of fastfetch's built-in logos, so there is no art file to
// ship; `fastfetch --list-logos` shows the rest. Its colour slots are not in
// reading order, and slot 2 is unused:
//   6  the outline and frame
//   5  top-left quadrant        4  top-right quadrant
//   1  bottom-left quadrant     3  bottom-right quadrant
// They are remapped here to the theme's palette, so the flag keeps its shape
// but reads as rose tints rather than the original primaries. The frame must
// not be left at its original black, which is invisible on a dark terminal.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "Windows 95",
        "color": {
            "6": "#c0c0c0",
            "5": "#a34545",
            "4": "#eb98a8",
            "1": "#997c7c",
            "3": "#808080"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            // #eb98a8 is the titlebar's text colour and stays legible on a dark
            // terminal; #a34545 is too dim against black for small text.
            "keys": "#eb98a8",
            "title": "#eb98a8"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "terminal",
        "cpu",
        "gpu",
        "memory"
    ]
}
