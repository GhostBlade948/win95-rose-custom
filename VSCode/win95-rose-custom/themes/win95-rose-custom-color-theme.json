        "peekViewResult.selectionBackground": "#a34545",
        "peekViewResult.selectionForeground": "#ffffff",
        "peekViewTitle.background": "#c0c0c0",

        "diffEditor.insertedTextBackground": "#00800020",
        "diffEditor.removedTextBackground": "#80000020",
        "diffEditor.border": "#808080",

        "activityBar.background": "#c0c0c0",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#808080",
        "activityBar.border": "#808080",
        "activityBar.activeBorder": "#a34545",
        "activityBarBadge.background": "#a34545",
        "activityBarBadge.foreground": "#ffffff",

        "sideBar.background": "#c0c0c0",
        "sideBar.foreground": "#000000",
        "sideBar.border": "#808080",
