{
    "name": "win95-rose-custom",
    "type": "light",
    "semanticHighlighting": true,
    "_comment": [
        "Windows 95 chrome: #c0c0c0 face, #ffffff highlight, #808080 shadow, #000000 text.",
        "Rose accents come from the desktop theme's titlebar colours and must stay in step",
        "with Theme/win95-rose-custom/gtk-3.0/gtk.css: #a34545 active, #eb98a8 its text,",
        "#997c7c inactive, #262323 inactive text.",
        "The editor itself is white like Notepad; every surrounding surface is silver."
    ],
    "colors": {
        "focusBorder": "#a34545",
        "foreground": "#000000",
        "descriptionForeground": "#404040",
        "errorForeground": "#800000",
        "widget.shadow": "#80808080",
        "selection.background": "#a34545",
        "icon.foreground": "#000000",
        "sash.hoverBorder": "#a34545",

        "window.activeBorder": "#a34545",
        "window.inactiveBorder": "#997c7c",

        "titleBar.activeBackground": "#a34545",
        "titleBar.activeForeground": "#eb98a8",
        "titleBar.inactiveBackground": "#997c7c",
        "titleBar.inactiveForeground": "#262323",
        "titleBar.border": "#000000",

        "editor.background": "#ffffff",
        "editor.foreground": "#000000",
        "editorLineNumber.foreground": "#808080",
        "editorLineNumber.activeForeground": "#a34545",
        "editorCursor.foreground": "#000000",
        "editor.selectionBackground": "#a34545",
        "editor.selectionForeground": "#ffffff",
        "editor.inactiveSelectionBackground": "#997c7c",
        "editor.selectionHighlightBackground": "#eb98a860",
        "editor.wordHighlightBackground": "#eb98a850",
        "editor.wordHighlightStrongBackground": "#eb98a880",
        "editor.findMatchBackground": "#eb98a8",
        "editor.findMatchHighlightBackground": "#eb98a870",
        "editor.lineHighlightBackground": "#f0f0f0",
        "editor.rangeHighlightBackground": "#eb98a840",
        "editorWhitespace.foreground": "#c0c0c0",
        "editorIndentGuide.background1": "#dfdfdf",
        "editorIndentGuide.activeBackground1": "#808080",
        "editorRuler.foreground": "#dfdfdf",
        "editorBracketMatch.background": "#eb98a880",
        "editorBracketMatch.border": "#a34545",
        "editorLink.activeForeground": "#000080",
        "editorOverviewRuler.border": "#808080",
        "editorError.foreground": "#800000",
        "editorWarning.foreground": "#808000",
        "editorInfo.foreground": "#000080",

        "editorGutter.background": "#ffffff",
        "editorGutter.addedBackground": "#008000",
        "editorGutter.modifiedBackground": "#000080",
        "editorGutter.deletedBackground": "#800000",

        "editorWidget.background": "#c0c0c0",
        "editorWidget.foreground": "#000000",
        "editorWidget.border": "#000000",
        "editorSuggestWidget.background": "#ffffff",
        "editorSuggestWidget.border": "#000000",
        "editorSuggestWidget.selectedBackground": "#a34545",
        "editorSuggestWidget.selectedForeground": "#ffffff",
        "editorSuggestWidget.highlightForeground": "#a34545",
        "editorHoverWidget.background": "#ffffe1",
